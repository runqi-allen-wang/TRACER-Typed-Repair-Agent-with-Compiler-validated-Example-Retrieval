{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/leancapsule-v0.1.schema.json",
  "title": "LeanCapsule manifest",
  "type": "object",
  "required": ["schema_version", "capsule_id", "target", "environment", "expected", "provenance", "replay"],
  "properties": {
    "schema_version": {"const": "leancapsule.v0.1"},
    "capsule_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["source_file", "selection_mode"],
      "properties": {
        "source_file": {"type": "string"},
        "theorem": {"type": ["string", "null"]},
        "lines": {"type": ["string", "null"]},
        "selection_mode": {"enum": ["theorem", "lines"]}
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "lean_toolchain": {"type": ["string", "null"]},
        "lake_manifest_present": {"type": "boolean"},
        "lakefile_present": {"type": "boolean"},
        "local_files": {"type": "array", "items": {"type": "string"}},
        "local_build_targets": {"type": "array", "items": {"type": "string"}},
        "dependency_project": {"type": ["string", "null"]}
      }
    },
    "expected": {
      "type": "object",
      "required": ["compile_ok", "category", "diagnostic_key"],
      "properties": {
        "compile_ok": {"type": "boolean"},
        "category": {"type": "string"},
        "diagnostic_key": {"type": "string"}
      }
    },
    "minimization": {"type": "object"},
    "taxonomy": {"enum": ["Name / import", "Type / application", "Elaboration / instance", "Goal / scope", null]},
    "source_kind": {"enum": ["std", "mathlib", "project_local", null]},
    "provenance": {
      "type": "object",
      "required": ["license", "source_url", "notes"],
      "properties": {
        "license": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    },
    "replay": {
      "type": "object",
      "required": ["file", "command"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1}
      }
    }
  }
}
